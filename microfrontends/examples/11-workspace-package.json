{
  "name": "enterprise-microfrontend-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise Angular 22+ Microfrontends Workspace (Native Federation, Web Components, Express Mock API)",
  "scripts": {
    "start:backend": "cd backend-mock && npm start",
    "start:shell": "ng serve gui-aggregator-service --port 4200",
    "start:faults": "ng serve fault-management --port 4201",
    "start:topology": "ng serve topology-manager --port 4202",
    "start:widgets": "ng serve dashboard-widgets --port 4203",
    "start:all": "concurrently -n \"API,SHELL,FAULTS,TOPO,WIDGETS\" -c \"magenta,blue,green,yellow,cyan\" \"npm run start:backend\" \"npm run start:shell\" \"npm run start:faults\" \"npm run start:topology\" \"npm run start:widgets\"",
    "build:all": "ng build gui-aggregator-service && ng build fault-management && ng build topology-manager && ng build dashboard-widgets"
  },
  "dependencies": {
    "@angular/animations": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/elements": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-browser-dynamic": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@angular-architects/native-federation": "^22.0.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "rxjs": "^7.8.1",
    "tslib": "^2.6.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.7",
    "concurrently": "^8.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0"
  }
}
