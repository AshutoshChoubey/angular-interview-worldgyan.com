{
  "name": "enterprise-microfrontends-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready enterprise multi-repo workspace using Angular 22+, Native Federation, Angular Elements, and Express Mock API.",
  "scripts": {
    "start:backend": "cd backend-mock && npm start",
    "start:shell": "ng serve gui-aggregator-service --port 4200",
    "start:faults": "ng serve fault-management --port 4201",
    "start:topology": "ng serve topology-manager --port 4202",
    "start:widgets": "ng serve dashboard-widgets --port 4203",
    "start:all": "concurrently -k -n \"API,SHELL,FAULTS,TOPO,WIDGETS\" -c \"magenta,blue,green,yellow,cyan\" \"npm run start:backend\" \"npm run start:shell\" \"npm run start:faults\" \"npm run start:topology\" \"npm run start:widgets\"",
    "build:all": "ng build gui-aggregator-service && ng build fault-management && ng build topology-manager && ng build dashboard-widgets"
  },
  "dependencies": {
    "@angular/animations": "^22.2.4",
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/elements": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@angular/platform-browser-dynamic": "^22.2.4",
    "@angular/router": "^22.2.4",
    "@angular-architects/native-federation": "^22.2.4",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.4",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.7",
    "concurrently": "^8.2.2",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  }
}
