{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "apps",
  "projects": {
    "gui-aggregator-service": {
      "projectType": "application",
      "schematics": {},
      "root": "apps/gui-aggregator-service",
      "sourceRoot": "apps/gui-aggregator-service/src",
      "prefix": "app",
      "architect": {
        "esbuild": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/gui-aggregator-service",
            "index": "apps/gui-aggregator-service/src/index.html",
            "browser": "apps/gui-aggregator-service/src/main.ts",
            "tsConfig": "apps/gui-aggregator-service/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "apps/gui-aggregator-service/src/assets",
                "output": "assets"
              }
            ],
            "styles": [
              "apps/gui-aggregator-service/src/styles.css"
            ],
            "scripts": [],
            "polyfills": [
              "es-module-shims"
            ]
          },
          "configurations": {
            "production": {
              "optimization": true,
              "extractLicenses": true,
              "sourceMap": false
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "build": {
          "builder": "@angular-architects/native-federation:build",
          "options": {
            "target": "gui-aggregator-service:esbuild:production",
            "rebuildDelay": 500,
            "federationConfigPath": "apps/gui-aggregator-service/federation.config.js"
          },
          "configurations": {
            "production": {
              "target": "gui-aggregator-service:esbuild:production"
            },
            "development": {
              "target": "gui-aggregator-service:esbuild:development",
              "dev": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve-original": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 4200
          },
          "configurations": {
            "production": {
              "buildTarget": "gui-aggregator-service:esbuild:production"
            },
            "development": {
              "buildTarget": "gui-aggregator-service:esbuild:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "serve": {
          "builder": "@angular-architects/native-federation:build",
          "options": {
            "target": "gui-aggregator-service:serve-original:development",
            "rebuildDelay": 500,
            "dev": true,
            "devServer": true,
            "port": 4200,
            "federationConfigPath": "apps/gui-aggregator-service/federation.config.js"
          }
        }
      }
    },
